rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt']) 
          && data.keys().size() == 5
          && data.uid == request.auth.uid
          && data.email is string && data.email.size() < 256
          && data.displayName is string && data.displayName.size() < 128
          && data.photoURL is string && data.photoURL.size() < 1024
          && data.createdAt == request.time;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    // Conversation Rules
    match /users/{userId}/conversations/{conversationId} {
      function isValidConversation(data) {
        return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt'])
          && data.keys().size() == 4
          && data.userId == userId
          && data.title is string && data.title.size() <= 200
          && data.createdAt == (request.method == 'create' ? request.time : existing().createdAt)
          && data.updatedAt == request.time;
      }

      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidConversation(incoming());
      allow update: if isOwner(userId) && isValidConversation(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
      allow delete: if isOwner(userId);
    }

    // Message Rules
    match /users/{userId}/conversations/{conversationId}/messages/{messageId} {
      function isValidMessage(data) {
        return data.keys().hasAll(['conversationId', 'role', 'content', 'timestamp', 'createdAt'])
          && data.role in ['user', 'ai']
          && data.content is string && data.content.size() <= 32768
          && data.conversationId == conversationId
          && data.timestamp is int
          && data.createdAt == request.time;
      }

      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidMessage(incoming());
      // Messages are typically immutable
      allow delete: if isOwner(userId);
    }
  }
}
